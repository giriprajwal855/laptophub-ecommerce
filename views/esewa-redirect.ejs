<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | LaptopHub</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%234f46e5'/><text y='.9em' font-size='90'>💻</text></svg>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
  <style>
    .esewa-redirect {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 40px 20px;
    }
    .esewa-redirect .spinner {
      width: 44px; height: 44px;
      border: 4px solid #e5e7f0;
      border-top-color: #60b515;
      border-radius: 50%;
      animation: spin .8s linear infinite;
      margin-bottom: 20px;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .esewa-redirect h1 { font-size: 22px; margin-bottom: 8px; }
    .esewa-redirect p { color: #6b7280; margin-bottom: 24px; }
    .esewa-redirect .pay-logo.esewa { width: 52px; height: 52px; font-size: 26px; margin: 0 auto 16px; }
  </style>
</head>
<body>
  <div class="esewa-redirect">
    <span class="pay-logo esewa">e</span>
    <div class="spinner"></div>
    <h1>Redirecting you to eSewa…</h1>
    <p>Please wait while we take you to the secure eSewa payment page. Do not close this window.</p>
    <noscript>
      <form action="<%= formUrl %>" method="POST">
        <% Object.entries(fields).forEach(([k, v]) => { %>
          <input type="hidden" name="<%= k %>" value="<%= v %>" />
        <% }) %>
        <button type="submit" class="btn btn-primary">Continue to eSewa</button>
      </form>
    </noscript>
    <form id="esewa-form" action="<%= formUrl %>" method="POST" style="display:none">
      <% Object.entries(fields).forEach(([k, v]) => { %>
        <input type="hidden" name="<%= k %>" value="<%= v %>" />
      <% }) %>
    </form>
    <button type="button" class="btn" onclick="document.getElementById('esewa-form').submit()">Continue to eSewa</button>
  </div>

  <script>
    document.getElementById('esewa-form').submit();
  </script>
</body>
</html>