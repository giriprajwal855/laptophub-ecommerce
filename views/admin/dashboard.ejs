<%- include('head') %>

<div class="stat-grid">
  <div class="stat-card">
    <span class="stat-label">Products</span>
    <strong class="stat-value"><%= stats.products %></strong>
  </div>
  <div class="stat-card">
    <span class="stat-label">Orders</span>
    <strong class="stat-value"><%= stats.orders %></strong>
  </div>
  <div class="stat-card">
    <span class="stat-label">Revenue</span>
    <strong class="stat-value"><%= formatPrice(stats.revenue) %></strong>
  </div>
  <div class="stat-card">
    <span class="stat-label">Users</span>
    <strong class="stat-value"><%= stats.users %></strong>
  </div>
</div>

<h2 class="admin-section-title">Recent Orders</h2>
<table class="admin-table">
  <thead>
    <tr>
      <th>Order</th>
      <th>Customer</th>
      <th>Amount</th>
      <th>Status</th>
      <th>Date</th>
    </tr>
  </thead>
  <tbody>
    <% if (recentOrders.length === 0) { %>
      <tr><td colspan="5" class="empty">No orders yet.</td></tr>
    <% } else { %>
      <% recentOrders.forEach(o => { %>
        <tr>
          <td class="mono"><%= o.orderId %></td>
          <td><%= o.customer.name %></td>
          <td><%= formatPrice(o.amount) %></td>
          <td><span class="status status-<%= o.status.toLowerCase() %>"><%= o.status %></span></td>
          <td><%= new Date(o.createdAt).toLocaleString() %></td>
        </tr>
      <% }) %>
    <% } %>
  </tbody>
</table>

<%- include('foot') %>