<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | Admin · LaptopHub</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%234f46e5'/><text y='.9em' font-size='90'>💻</text></svg>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
  <div class="admin-shell">
    <aside class="admin-sidebar">
      <a href="/admin" class="admin-logo">
        <span class="admin-logo-mark">LH</span>
        <span class="admin-logo-text">LaptopHub<em>Admin</em></span>
      </a>
      <nav class="admin-nav">
        <a href="/admin" class="<%= path === '/admin' ? 'active' : '' %>">Dashboard</a>
        <a href="/admin/orders" class="<%= path === '/admin/orders' ? 'active' : '' %>">Orders</a>
        <a href="/admin/products" class="<%= path === '/admin/products' ? 'active' : '' %>">Products</a>
        <a href="/admin/users" class="<%= path === '/admin/users' ? 'active' : '' %>">Users</a>
      </nav>
      <div class="admin-side-foot">
        <a href="/" class="admin-back">← Back to store</a>
        <form action="/admin/logout" method="post">
          <button type="submit" class="btn-logout">Logout</button>
        </form>
      </div>
    </aside>
    <div class="admin-main">
      <header class="admin-topbar">
        <h1><%= title %></h1>
      </header>
      <main class="admin-content">