<%- include('head') %>

<div class="toolbar">
  <span class="toolbar-count"><%= products.length %> products</span>
  <a href="/admin/products/new" class="btn btn-primary">+ Add Product</a>
</div>

<table class="admin-table">
  <thead>
    <tr>
      <th></th>
      <th>Product</th>
      <th>Brand</th>
      <th>Category</th>
      <th>Price</th>
      <th>Rating</th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% products.forEach(p => { %>
      <tr>
        <td class="thumb-cell"><img src="<%= p.image %>" alt="" class="thumb" /></td>
        <td>
          <div class="product-name"><%= p.name %></div>
          <% if (p.badge) { %><span class="badge-tag"><%= p.badge %></span><% } %>
        </td>
        <td><%= p.brand %></td>
        <td><%= p.category %></td>
        <td>
          <div><%= formatPrice(p.price) %></div>
          <% if (p.oldPrice) { %><div class="muted strike"><%= formatPrice(p.oldPrice) %></div><% } %>
        </td>
        <td>★ <%= p.rating %></td>
        <td>
          <div class="row-actions">
            <a href="/admin/products/<%= p.id %>/edit" class="btn btn-sm">Edit</a>
            <form action="/admin/products/<%= p.id %>/delete" method="post" class="inline-form"
                  onsubmit="return confirm('Delete <%= p.name %>?');">
              <button type="submit" class="btn btn-sm btn-danger">Delete</button>
            </form>
          </div>
        </td>
      </tr>
    <% }) %>
  </tbody>
</table>

<%- include('foot') %>