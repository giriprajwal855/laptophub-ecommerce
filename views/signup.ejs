<%- include('partials/header', { title, q: '' }) %>

  <section class="auth-page">
    <div class="container">
      <div class="auth-card">
        <h1>Create your account</h1>
        <p>Sign up to start shopping in just a minute.</p>

        <% if (error) { %><div class="form-alert"><%= error %></div><% } %>

        <form action="/signup" method="post" class="auth-form">
          <input type="hidden" name="next" value="<%= next %>" />
          <div class="form-field">
            <label for="name">Full Name</label>
            <input type="text" id="name" name="name" required placeholder="Ram Sharma" autofocus />
          </div>
          <div class="form-field">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" required placeholder="you@example.com" />
          </div>
          <div class="form-field">
            <label for="phone">Phone Number (optional)</label>
            <input type="tel" id="phone" name="phone" placeholder="9800000000" />
          </div>
          <div class="form-field">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" required placeholder="At least 6 characters" />
          </div>
          <div class="form-field">
            <label for="confirm">Confirm Password</label>
            <input type="password" id="confirm" name="confirm" required placeholder="Repeat your password" />
          </div>
          <button type="submit" class="btn btn-primary btn-block btn-lg">Sign Up</button>
        </form>

        <p class="auth-alt">Already have an account? <a href="/login?next=<%= encodeURIComponent(next) %>">Log in</a></p>
      </div>
    </div>
  </section>

<%- include('partials/footer') %>